# ── Sanity ──────────────────────────────────────────────────────────
# Leave PUBLIC_SANITY_PROJECT_ID empty to run on local fixtures (seed/data/*.ndjson via groq-js).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-09-01
PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
PUBLIC_SITE_URL=http://localhost:5173

# Viewer token: drafts for live preview / Presentation tool (server only)
SANITY_API_READ_TOKEN=
# Signs the Sanity webhook -> /api/revalidate and is the Vercel ISR bypass token (min 32 chars)
SANITY_REVALIDATE_SECRET=
# Editor token, used only by `pnpm seed` (never exposed to the web app)
SANITY_API_WRITE_TOKEN=
